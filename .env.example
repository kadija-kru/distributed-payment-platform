APP_ENVIRONMENT=local
APP_DATABASE_URL=postgresql+asyncpg://payment:payment@postgres:5432/payment_platform
APP_REDIS_URL=redis://redis:6379/0
APP_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
APP_KAFKA_TOPIC=payment-events
APP_KAFKA_DLQ_TOPIC=payment-events-dlq
APP_JWT_SECRET=change-me-with-a-long-random-secret
APP_RATE_LIMIT_PER_MINUTE=60
APP_FRAUD_REJECT_ABOVE=10000
APP_MAX_EVENT_RETRIES=3
